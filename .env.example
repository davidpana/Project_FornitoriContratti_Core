PORT=3000

# IOTA testnet node endpoint
IOTA_NODE_URL=https://api.testnet.iota.cafe

# 24-word or 12-word mnemonic used by the backend wallet (do not commit real secret)
IOTA_MNEMONIC=replace-with-your-mnemonic

# Optional derivation path (SLIP-0010). If omitted, SDK default is used.
IOTA_DERIVATION_PATH=

# Wallet/account settings
IOTA_ACCOUNT_INDEX=0
IOTA_MIN_BALANCE=100000000

# Delete lock duration for locked notarization (10 years default)
IOTA_DELETE_UNLOCK_SECONDS=315360000

# Explorer object URL prefix
IOTA_EXPLORER_BASE_URL=https://explorer.iota.org/object/

# Faucet endpoint (v1)
IOTA_FAUCET_URL=https://faucet.testnet.iota.cafe/v1/gas
